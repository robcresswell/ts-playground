{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "unicorn",
    "typescript",
    "eslint",
    "oxc",
    "import",
    "node",
    "promise"
  ],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "curly": ["error", "all"],
    "arrow-body-style": ["error", "always"]
  },
  "ignorePatterns": []
}
