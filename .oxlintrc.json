{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "unicorn",
    "typescript",
    "eslint",
    "oxc",
    "import",
    "node",
    "promise"
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "overrides": [
    {
      "files": ["test/**/*.test.ts"],
      "plugins": ["vitest"]
    }
  ],
  "rules": {},
  "ignorePatterns": []
}
