{
  "name": "playground",
  "private": true,
  "description": "",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "NODE_ENV=development bun --no-orphans --no-addons --hot --watch --enable-source-maps .",
    "build": "tsc --project tsconfig.build.json",
    "t": "AGENT=1 bun --no-orphans --no-addons test --parallel --concurrent",
    "coverage": "AGENT=1 bun --no-orphans --no-addons test --coverage --parallel --concurrent",
    "start": "NODE_ENV=production bun --no-orphans --no-addons  --enable-source-maps .",
    "lint": "bun --parallel 'oxlint' 'oxfmt --check' 'typecheck'",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "lint:fix": "oxlint --fix '{src,test}/**/*.{ts,json,md}' && oxfmt"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "bun-types": "^1.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "version": ">=1.4.0",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
